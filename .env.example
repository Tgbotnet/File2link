# ---- required ----
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=
DATABASE_URL=
FLOG_CHANNEL=
ULOG_CHANNEL=

# ---- branding ----
BOT_USERNAME=My_file_2_link_bot
OWNER_USERNAME=My_file_2_link_bot
UPDATES_CHANNEL=My_file_2_link_bot

# Leave these blank to use the branded images bundled in FileStream/assets
START_PIC=
FILE_PIC=
VERIFY_PIC=

# ---- web server ----
PORT=8080
BIND_ADDRESS=0.0.0.0
FQDN=
HAS_SSL=False
NO_PORT=False

# ---- admin dashboard ----
# The /admin dashboard stays DISABLED until both of these are set.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- download speed tuning ----
# Chunks of a single download fetched from Telegram at the same time (max 40).
MAX_PARALLEL_PARTS=40
# Separate MTProto connections per bot client, per data centre (max 16).
# This is the main throughput lever: one connection sustains roughly 2-5 MB/s.
SESSIONS_PER_DC=12
# Downloads smaller than this stay single-shot.
PARALLEL_MIN_MB=1
# Process-wide cap on in-flight chunks. Roughly your peak streaming RAM in MB.
MAX_TOTAL_PARTS=240
# If a chunk hasn't arrived in this many ms, re-request it on another
# connection and keep whichever answers first. This is what keeps the speed
# flat instead of sawtoothing. Set to 0 to disable.
HEDGE_AFTER_MS=2500
# Max requests queued on any single connection.
MAX_INFLIGHT_PER_SESSION=6

# ---- file naming ----
# Use the message caption as the file name when one is present.
NAME_FROM_CAPTION=True
# Keep only the first N words of the caption.
CAPTION_MAX_WORDS=13
# Hard character cap on the generated name.
CAPTION_MAX_CHARS=120

# ---- cloudflare tunnel ----
# Paste the token from Zero Trust > Networks > Tunnels. When set, the bot runs
# cloudflared itself on every start, so a home server with no public IP and no
# port forwarding still serves links.
# In the dashboard, point the public hostname's service at http://localhost:8080
# and set FQDN below to that same hostname.
TUNNEL_TOKEN=
# Set False to keep the token but leave the tunnel off.
TUNNEL_ENABLED=True
# Download cloudflared automatically when it isn't installed.
TUNNEL_AUTO_INSTALL=True
# Path to an existing cloudflared binary (leave blank to search PATH).
CLOUDFLARED_PATH=
# Where an auto-downloaded cloudflared is kept.
TUNNEL_INSTALL_DIR=bin
# auto | quic | http2 -- use http2 if your network blocks UDP port 7844.
TUNNEL_PROTOCOL=auto
TUNNEL_LOGLEVEL=info

# With a tunnel, these three must match the hostname you configured:
# FQDN=files.example.com
# HAS_SSL=True
# NO_PORT=True

# ---- link lifetime ----
# Hours a generated link stays alive. Set to 0 to keep links forever.
LINK_EXPIRY_HOURS=24
# How often the background janitor hunts for dead links, in seconds.
CLEANUP_INTERVAL=300
# Maximum links retired in one sweep.
SWEEP_BATCH=200
# On revoke/expiry, also delete the stored copy from the log channel.
DELETE_FROM_LOG=True
# On revoke/expiry, also delete the upload + link message from the user's chat.
DELETE_USER_CHAT=True

# ---- batch links ----
# Bundle a burst of uploads into one copy-once message.
BATCH_LINKS=True
# Seconds of silence after the last upload before the summary is sent.
BATCH_WINDOW=6
# Don't summarise fewer files than this (a single file already gets a reply).
BATCH_MIN_FILES=2
# Upper bound on links in one summary, and on /links.
BATCH_MAX_FILES=100

# ---- optional ----
FORCE_SUB=False
FORCE_SUB_ID=
AUTH_USERS=
WORKERS=6
SLEEP_THRESHOLD=60
MODE=primary
